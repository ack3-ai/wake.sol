/target
# Nested Rust build artifacts (programs/*/target, etc.) — /target only anchors root.
**/target/
**/__pycache__/
*.py[cod]
*.so
*.pyd
*.dylib
/dist
/build
*.egg-info
.venv/
venv/
.python-version

# Generated by `wake-sol gen` (build artifact; regenerate with `gen`)
/pytypes/
*.tmp/

# Default mainnet-fork snapshot cache (svm.fork(...)). Commit one deliberately
# (see docs/13-forking.md) if a test needs a hermetic, checked-in fork.
/fork-cache/
# Non-default fork caches wherever a test points svm.fork(cache=...).
**/.fork-cache/

# Runtime artifacts: crash.txt (--attach post-mortem) and per-worker logs
# (`wake-sol test -P` writes .wake-sol/logs/testing/process-N.ansi).
/.wake-sol/

# Local editor / tooling settings — per-machine, not shared.
.claude/settings.local.json
.pytest_cache/

/design/
.devcontainer/
