/target
# Nested Rust build artifacts (programs/*/target, etc.) — /target only anchors root.
**/target/
**/__pycache__/
*.py[cod]
*.so
*.pyd
*.dylib
/dist
/build
*.egg-info
.venv/
venv/
.python-version

# Generated by `wake-sol gen` (build artifact; regenerate with `gen`)
/pytypes/
*.tmp/

# Default mainnet-fork snapshot cache (svm.fork(...)); commit intentionally per
# design/forking-spec/ §5.4 if a test needs a hermetic, checked-in fork.
/fork-cache/
# Per-example fork caches (examples/*/*.py write here on live runs).
**/.fork-cache/

# Runtime artifacts: crash.txt (--attach post-mortem) and per-worker logs
# (`wake-sol test -P` writes .wake-sol/logs/testing/process-N.ansi).
/.wake-sol/

# Local Claude Code settings — personal machine paths / permissions, not shared.
.claude/settings.local.json

# Internal design & spec docs — kept local, intentionally uncommitted for now.
/design/
.devcontainer/
